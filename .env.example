# Copy this file to .env.local and fill in the values.

# Public address of the app. Optional locally (defaults to the address you
# open the app on). Set it on Vercel to your real domain.
APP_URL=http://localhost:3000

# Any unique name for this app. Lichess needs no registration.
LICHESS_CLIENT_ID=knockout-chess

# Random secret used to sign login cookies. At least 32 characters.
SESSION_SECRET=

# From your Supabase project (see README, "Supabase setup").
SUPABASE_URL=
SUPABASE_SECRET_KEY=
